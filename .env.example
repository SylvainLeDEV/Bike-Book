# Example configuration. Copy to `.env` (Docker Compose) or `.env.local` (pnpm dev).
# Every value here is a placeholder: never commit a real .env file.

# Signs session cookies. Required in production, at least 32 characters.
# Generate one with: openssl rand -base64 32
# (This placeholder is refused in production on purpose.)
AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32

# The origin users type in their browser, without a path. Required in production.
# Session cookies get the Secure flag only when this starts with https://.
PUBLIC_URL=http://localhost:3000

# Other origins you also open the app at, comma-separated (e.g. the server's IP and port next
# to a DNS name). Sign-in is refused from any origin that is neither PUBLIC_URL nor listed here.
# TRUSTED_ORIGINS=http://192.168.1.20:3000

# Self sign-up. Off by default: only the first-launch setup screen creates an account.
ALLOW_SIGNUP=false

# Where the database and files live. Defaults to ./data; the Docker image uses /data.
# Must be a local filesystem, never NFS or SMB.
# DATA_DIR=./data

# Display timezone.
TZ=Europe/Paris

# Garmin Connect import (D-101). The personal API key is typed in Paramètres (stored encrypted
# with a key derived from AUTH_SECRET), never here. Every value below has a default.
# GARMIN_SYNC_INTERVAL_H=6           # hours between automatic imports; 0 = off
# GARMIN_MIN_DURATION_S=60           # leave out activities shorter than this (stray recordings)
# GARMIN_TOKEN_REFRESH_MARGIN_S=3600 # ask for a new token when less than this is left
# GARMIN_KEY_WARN_DAYS=30,7          # warn this many days before the key expires
# GARMIN_DOWNLOAD_FIT=false          # keep each imported ride's FIT file as an attachment
