      "checkConstraints": {
        "bikes_discipline_check": {
          "name": "bikes_discipline_check",
          "value": "\"bikes\".\"discipline\" in ('road', 'gravel', 'xc', 'trail', 'enduro', 'dh', 'dirt', 'city', 'other')"
        },
        "bikes_wheel_size_check": {
          "name": "bikes_wheel_size_check",
          "value": "\"bikes\".\"wheel_size\" in ('29', '27.5', '26', 'mullet', '700c', '650b', 'other')"
        },
        "bikes_status_check": {
          "name": "bikes_status_check",
          "value": "\"bikes\".\"status\" in ('active', 'stored', 'sold', 'stolen', 'retired')"
        },
        "bikes_sale_price_check": {
          "name": "bikes_sale_price_check",
          "value": "\"bikes\".\"sale_price_cents\" is null or (\"bikes\".\"status\" = 'sold' and \"bikes\".\"sale_price_cents\" >= 0)"
        },
        "bikes_amounts_check": {
          "name": "bikes_amounts_check",
          "value": "(\"bikes\".\"purchase_price_cents\" is null or \"bikes\".\"purchase_price_cents\" >= 0) and (\"bikes\".\"weight_g\" is null or \"bikes\".\"weight_g\" > 0) and \"bikes\".\"initial_distance_m\" >= 0 and \"bikes\".\"initial_wear_s\" >= 0"
        }
      }
